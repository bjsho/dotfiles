                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "e",
                                        "modifiers": ["right_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Window Management: Maximise",
                                "from": {
                                    "key_code": "w",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "f",
                                        "modifiers": ["left_control", "fn"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Window Management: Half: Left",
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["left_control", "fn"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Window Management: Half: Right",
                                "from": {
                                    "key_code": "e",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": ["left_control", "fn"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.microsoft\\.Word$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "description": "APP SPECIFIC - Word: Multiply LaTeX",
                                "from": {
                                    "key_code": "8",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [
                                    { "key_code": "backslash" },
                                    { "key_code": "t" },
                                    { "key_code": "i" },
                                    { "key_code": "m" },
                                    { "key_code": "e" },
                                    { "key_code": "s" },
                                    { "key_code": "spacebar" }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Command Spacebar",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["left_control"] }
                                },
                                "to": [{ "key_code": "spacebar" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 45915,
                        "vendor_id": 1133
                    },
                    "ignore": false,
