                                },
                                "to": [{ "shell_command": "open -a 'Music.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Anki",
                                "from": {
                                    "key_code": "a",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Anki.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Discord",
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Discord.app'" }],
