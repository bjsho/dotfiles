{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "ctrl+left click to left click",
                        "manipulators": [
                            {
                                "from": {
                                    "modifiers": { "mandatory": ["control"] },
                                    "pointing_button": "button1"
                                },
                                "to": [{ "pointing_button": "button1" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "manipulators": [
                            {
                                "description": "Make Caps Lock the Hyper Key and make the run various applications and tasks",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Open Karabiner Elements Config",
                                "from": {
                                    "key_code": "comma",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Visual Studio Code.app' '/Users/sbc/.config/karabiner/karabiner.json'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Activity Monitor",
                                "from": {
                                    "key_code": "escape",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Activity Monitor.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Default Word tempalte",
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Microsoft Word.app' '/Users/sbc/Documents/dotx'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Finder",
                                "from": {
                                    "key_code": "x",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Finder.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Browser",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Helium.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Calendar",
