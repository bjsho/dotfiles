                                    "key_code": "d",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Notion Calendar.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Notion",
                                "from": {
                                    "key_code": "r",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
                                },
                                "to": [{ "shell_command": "open -a 'Notion.app'" }],
                                "type": "basic"
                            },
                            {
                                "description": "Open Mails",
                                "from": {
                                    "key_code": "z",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command", "left_shift"] }
